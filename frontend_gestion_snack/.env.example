# ============================================================
# Variables d'environnement - Frontend Gestion Snack
# Copier ce fichier en .env et renseigner les valeurs
# ============================================================

# URL de l'API backend
# - Local:      http://localhost:8080/api
# - Production: https://votre-domaine.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# Clé publique Stripe (paiement par carte) - dashboard Stripe > Developers > API keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Les clés Groq et ElevenLabs sont désormais gérées côté backend.
# Ne pas ajouter VITE_GROQ_API_KEY ni VITE_ELEVENLABS_API_KEY ici.
