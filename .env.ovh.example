# ============================================================
# Variables d'environnement - Backend sur VPS OVH
# Copier ce fichier en ".env" (a la racine du repo, sur le VPS)
# et renseigner les vraies valeurs. Ne JAMAIS committer ce fichier
# une fois rempli (deja exclu par .gitignore via la regle ".env").
# ============================================================

# --- Base de donnees Neon.tech (reprendre les valeurs actuelles de Render) ---
DATABASE_URL=jdbc:postgresql://<host>.neon.tech/neondb?sslmode=require&channel_binding=require&stringtype=unspecified
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=

# --- URLs publiques (a adapter au domaine achete pour l'OVH) ---
# Meme domaine que le frontend puisque Nginx route /api et /ws vers le backend
# ALLOWED_ORIGINS sert aussi aux origines WebSocket autorisees (WebSocketConfig.java)
ALLOWED_ORIGINS=https://votre-domaine.com
FRONTEND_URL=https://votre-domaine.com

# --- Cloudinary (stockage images produits) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- IA chatbot ---
GROQ_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# --- Paiements Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email transactionnel (Brevo) ---
BREVO_API_KEY=
BREVO_FROM_EMAIL=
